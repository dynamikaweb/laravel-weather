{
    "name": "dynamikasolucoesweb/laravel-weather",
    "description": "Um componente Blade de clima/previsão do tempo utilizando a API Open-Meteo para Laravel.",
    "type": "library",
    "keywords": ["dynamika", "laravel", "weather"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Giordani da Silveira dos Santos",
            "email": "giordani@dynamika.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "DynamikaSolucoesWeb\\LaravelWeather\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DynamikaSolucoesWeb\\LaravelWeather\\WeatherServiceProvider"
            ]
        }
    }
}